\ProvidesPackage{labguard_pdf}[2026/09/21 LabGuard NT106 Professional Style]

\RequirePackage{fontspec}
\setmainfont{Times New Roman}
\setmonofont{Consolas}[Scale=0.92]

\RequirePackage[a4paper, top=22mm, bottom=20mm, left=25mm, right=20mm, headheight=25pt]{geometry}
\RequirePackage{lastpage}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\renewcommand{\contentsname}{MỤC LỤC}
\RequirePackage{float}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,fit,calc}

% Define color palette
\definecolor{lgDeepBlue}{RGB}{27,54,93}      % #1B365D
\definecolor{lgTeal}{RGB}{15,118,110}        % #0F766E
\definecolor{lgCrimson}{RGB}{185,28,28}      % #B91C1C
\definecolor{lgSlate}{RGB}{30,41,59}         % #1E293B
\definecolor{lgLightSlate}{RGB}{241,245,249} % #F1F5F9
\definecolor{lgForestGreen}{RGB}{22,101,52}  % #166534
\definecolor{lgLightGreen}{RGB}{240,253,244} % #F0FDF4
\definecolor{lgLightRed}{RGB}{254,242,242}   % #FEF2F2
\definecolor{lgLightBlue}{RGB}{239,246,255}  % #EFF6FF
\definecolor{lgLightTeal}{RGB}{240,253,250}  % #F0FDFA
\definecolor{lgGray}{RGB}{100,116,139}       % #64748B
\definecolor{lgLightGray}{RGB}{248,250,252}  % #F8FAFC

% Hyperref setup
\RequirePackage[
  colorlinks=true,
  linkcolor=lgDeepBlue,
  citecolor=lgTeal,
  urlcolor=lgTeal,
  filecolor=lgDeepBlue,
  pdfstartview=FitH,
  bookmarksnumbered=true,
  bookmarksopen=true
]{hyperref}

% Header and Footer setup
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{lgDeepBlue}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{lgGray}\leaders\hrule height \footrulewidth\hfill}}

\fancyhead[L]{\small\color{lgSlate}\textit{\nouppercase{\leftmark}}}
\fancyhead[R]{\small\bfseries\color{lgDeepBlue}{LabGuard — NT106}}
\fancyfoot[L]{\footnotesize\color{lgGray}{Trường ĐH Công nghệ Thông tin — ĐHQG-HCM}}
\fancyfoot[R]{\footnotesize\bfseries\color{lgDeepBlue}{\thepage\ / \pageref{LastPage}}}

% Section styling
\titleformat{\section}
  {\Large\bfseries\color{lgDeepBlue}}
  {\thesection.}{0.8em}{}
  [{\titlerule[1pt]}]

\titleformat{\subsection}
  {\large\bfseries\color{lgTeal}}
  {\thesubsection}{0.6em}{}

\titleformat{\subsubsection}
  {\normalsize\bfseries\color{lgSlate}}
  {\thesubsubsection}{0.5em}{}

% Custom TColorBoxes
\newtcolorbox{importantbox}[1][]{
  enhanced, breakable,
  colback=lgLightBlue, colframe=lgDeepBlue,
  boxrule=1pt, arc=2mm,
  top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
  before skip=3mm, after skip=3mm,
  title={\textbf{GHI CHÚ QUAN TRỌNG}},
  fonttitle=\bfseries\color{white},
  #1
}

\newtcolorbox{pitfallbox}[1][]{
  enhanced, breakable,
  colback=lgLightRed, colframe=lgCrimson,
  boxrule=1pt, arc=2mm,
  top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
  before skip=3mm, after skip=3mm,
  title={\textbf{CẢNH BÁO BẪY LỖI \& THỰC HÀNH CẦN TRÁNH}},
  fonttitle=\bfseries\color{white},
  #1
}

\newtcolorbox{conceptbox}[1][]{
  enhanced, breakable,
  colback=lgLightTeal, colframe=lgTeal,
  boxrule=1pt, arc=2mm,
  top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
  before skip=3mm, after skip=3mm,
  title={\textbf{KHÁI NIỆM MẠNG CỐT LÕI}},
  fonttitle=\bfseries\color{white},
  #1
}

\newtcolorbox{checklistbox}[1][]{
  enhanced, breakable,
  colback=lgLightGreen, colframe=lgForestGreen,
  boxrule=1pt, arc=2mm,
  top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
  before skip=3mm, after skip=3mm,
  title={\textbf{TIÊU CHÍ NGHIỆM THU (ACCEPTANCE CRITERIA)}},
  fonttitle=\bfseries\color{white},
  #1
}

\newtcolorbox{codebox}[1][]{
  enhanced, breakable,
  colback=lgLightGray, colframe=lgSlate,
  boxrule=0.8pt, arc=1.5mm,
  top=2mm, bottom=2mm, left=2.5mm, right=2.5mm,
  before skip=2.5mm, after skip=2.5mm,
  fonttitle=\bfseries\color{white},
  #1
}

\newtcolorbox{summarybox}[1][]{
  enhanced, breakable,
  colback=lgLightTeal, colframe=lgTeal,
  boxrule=1pt, arc=2mm,
  top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
  before skip=3mm, after skip=3mm,
  title={\textbf{TÓM TẮT 30 GIÂY}},
  fonttitle=\bfseries\color{white},
  #1
}

\newtcolorbox{takeawaybox}[1][]{
  enhanced, breakable,
  colback=lgLightBlue, colframe=lgDeepBlue,
  boxrule=1pt, arc=2mm,
  top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
  before skip=3mm, after skip=3mm,
  title={\textbf{SAU PHẦN NÀY, BẠN CHỈ CẦN NHỚ:}},
  fonttitle=\bfseries\color{white},
  #1
}

\newtcolorbox{orientationbox}[1][]{
  enhanced, breakable,
  colback=white, colframe=lgSlate!60,
  boxrule=0.7pt, arc=1.5mm,
  top=2mm, bottom=2mm, left=3mm, right=3mm,
  before skip=2mm, after skip=1.5mm,
  title={\textbf{ĐOẠN NÀY CẦN NHÌN ĐIỀU GÌ?}},
  fonttitle=\footnotesize\bfseries\color{white},
  coltitle=white,
  colbacktitle=lgSlate!80,
  #1
}

% Listings setup
\lstset{
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{lgLightSlate},
  keywordstyle=\bfseries\color{lgDeepBlue},
  stringstyle=\color{lgCrimson},
  commentstyle=\itshape\color{lgForestGreen},
  numberstyle=\tiny\color{lgGray},
  numbers=left,
  stepnumber=1,
  numbersep=8pt,
  frame=single,
  rulecolor=\color{lgGray!40},
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  tabsize=2,
  captionpos=b,
  xleftmargin=12pt,
  framexleftmargin=8pt
}

\lstdefinelanguage{CSharp}{
  keywords={abstract, as, base, bool, break, byte, case, catch, char, checked,
    class, const, continue, decimal, default, delegate, do, double, else,
    enum, event, explicit, extern, false, finally, fixed, float, for,
    foreach, goto, if, implicit, in, int, interface, internal, is, lock,
    long, namespace, new, null, object, operator, out, override, params,
    private, protected, public, readonly, ref, return, sbyte, sealed,
    short, sizeof, stackalloc, static, string, struct, switch, this,
    throw, true, try, typeof, uint, ulong, unchecked, unsafe, ushort,
    using, virtual, void, volatile, while, async, await, var, record},
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  morestring=[b]'
}

\lstdefinelanguage{Json}{
  basicstyle=\ttfamily\footnotesize,
  stringstyle=\color{lgTeal},
  keywords={true, false, null},
  keywordstyle=\bfseries\color{lgCrimson},
  morestring=[b]",
  showstringspaces=false
}

\setlist[itemize]{leftmargin=1.8em, itemsep=0.2em, topsep=0.3em}
\setlist[enumerate]{leftmargin=1.8em, itemsep=0.2em, topsep=0.3em}
